<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/backg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".raiting">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/imagev"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="20dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout5"
            android:layout_width="120dp"
            android:layout_height="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imagev">

            <TextView
                android:id="@+id/views"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="2"
                android:textSize="11dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/eye"
                app:layout_constraintLeft_toRightOf="@id/HEART"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/eye"
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:src="@drawable/eye"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.0"
                android:textSize="11dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/HEART"
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:src="@drawable/heart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@id/views"
                app:layout_constraintStart_toEndOf="@id/likes"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
            android:id="@+id/name"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:text="Глубокие ямы"
            android:textSize="22dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/desciption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:text="Город: Ростов-на-Дону"
            android:textSize="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout5" />

        <TextView
            android:id="@+id/category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:text="Техническое"
            android:textColor="#008DDF"
            android:textSize="17dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/name" />

        <TextView
            android:id="@+id/statusot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="7dp"
            android:text="В процессе выполнения"
            android:textColor="#707070"
            android:textSize="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imagev" />


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardofrate">

        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_corner">
            <!-- Другие элементы вашего макета, если есть -->
        </FrameLayout>

    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardofrate"
        android:layout_width="match_parent"
        android:background="@drawable/rounded_for_white_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@+id/desciption">

        <TextView
            android:id="@+id/textDescRating"
            android:layout_marginTop="20dp"
            android:textSize="16dp"
            android:layout_marginStart="20dp"
            android:text="Средний рейтинг"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/rateAmmount"
            app:layout_constraintTop_toBottomOf="@id/textDescRating"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:text="0"
            android:textColor="@color/black"
            android:textSize="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_marginBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_marginStart="7dp"
            android:text="/ 5"
            android:textSize="19dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/rateAmmount"
            app:layout_constraintStart_toEndOf="@id/rateAmmount" />

        <RelativeLayout
            android:id="@+id/star1"
            android:background="@drawable/inactive_star"
            android:layout_marginTop="26dp"
            app:layout_constraintTop_toBottomOf="@id/rateAmmount"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20dp"
            android:layout_width="24dp"
            android:layout_height="20dp">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/star2"
            android:layout_marginStart="4dp"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/inactive_star"
            app:layout_constraintStart_toEndOf="@+id/star1"
            app:layout_constraintTop_toBottomOf="@id/rateAmmount">

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/star3"
            android:layout_marginStart="4dp"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/inactive_star"
            app:layout_constraintStart_toEndOf="@+id/star2"
            app:layout_constraintTop_toBottomOf="@id/rateAmmount">

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/star4"
            android:layout_marginStart="4dp"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/inactive_star"
            app:layout_constraintStart_toEndOf="@+id/star3"
            app:layout_constraintTop_toBottomOf="@id/rateAmmount">

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/star5"
            android:layout_marginStart="4dp"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/inactive_star"
            app:layout_constraintStart_toEndOf="@+id/star4"
            app:layout_constraintTop_toBottomOf="@id/rateAmmount">

        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="150dp"
            android:layout_height="fill_parent"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:text="5 ◴"
                app:layout_constraintTop_toTopOf="@id/prbar5"
                app:layout_constraintBottom_toBottomOf="@id/prbar5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="4 ◴"
                app:layout_constraintTop_toTopOf="@id/prbar4"
                app:layout_constraintBottom_toBottomOf="@id/prbar4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="3 ◴"
                app:layout_constraintTop_toTopOf="@id/prbar3"
                app:layout_constraintBottom_toBottomOf="@id/prbar3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="2 ◴"
                app:layout_constraintTop_toTopOf="@id/prbar2"
                app:layout_constraintBottom_toBottomOf="@id/prbar2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:text="1 ◴"
                app:layout_constraintTop_toTopOf="@id/prbar1"
                app:layout_constraintBottom_toBottomOf="@id/prbar1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ProgressBar
                android:layout_marginStart="27dp"
                android:src="@drawable/custom_progress_bar"
                android:id="@+id/prbar5"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:layout_marginStart="27dp"
                android:src="@drawable/custom_progress_bar"
                android:id="@+id/prbar4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/prbar3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/prbar5" />

            <ProgressBar
                android:layout_marginStart="27dp"
                android:src="@drawable/custom_progress_bar"
                android:id="@+id/prbar3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/prbar2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/prbar4" />

            <ProgressBar
                android:layout_marginStart="27dp"
                android:src="@drawable/custom_progress_bar"
                android:id="@+id/prbar2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/prbar1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/prbar3" />

            <ProgressBar
                android:layout_marginStart="27dp"
                android:src="@drawable/custom_progress_bar"
                android:id="@+id/prbar1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/prbar2" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>